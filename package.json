{
  "name": "@vantin/backendguard",
  "version": "0.9.1",
  "description": "AI backend engineering guardrails for NestJS, PostgreSQL, TypeORM, and Prisma — task-aware security/architecture/database context for AI coding agents, plus post-task compliance reporting.",
  "type": "module",
  "bin": {
    "backendguard": "cli/backendguard.js",
    "backendguard-codex": "cli/backendguard.js"
  },
  "files": [
    "cli/",
    "rules/",
    "retrieval/",
    "analysis/",
    "compliance/",
    "agent-context/",
    "integrations/",
    "runtime/",
    "evaluation/",
    "!evaluation/**/fixtures/**",
    "skills/",
    "tooling/",
    "plugins/",
    ".agents/",
    ".codex/skills/",
    ".codex/workflows/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:mcp": "node tests/mcp-protocol-smoke.js",
    "test:package": "node tests/package-lifecycle.test.mjs",
    "validate:plugin": "node tests/validate-plugin.js",
    "evaluate": "node evaluation/release-readiness/run-evaluation.js",
    "evaluate:detection": "node evaluation/detection-quality/run-detection-eval.js",
    "benchmark:skills": "node cli/backendguard.js benchmark --skills",
    "leaderboard:hallucination": "node evaluation/hallucination/run-leaderboard.js",
    "leaderboard:agents": "node evaluation/hallucination/run-agent-leaderboard.js --agents=codex,gemini",
    "demo:capture": "node docs/demo/capture-live-demos.mjs",
    "sync:skills": "node tooling/sync-skill-library.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "keywords": [
    "backend",
    "nestjs",
    "postgresql",
    "typeorm",
    "prisma",
    "security",
    "compliance",
    "codex",
    "claude-code",
    "antigravity",
    "plugin",
    "agents",
    "context",
    "hooks",
    "mcp",
    "semantic-search",
    "agents-md",
    "developer-tools"
  ],
  "author": {
    "name": "BackendGuard"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "smol-toml": "^1.6.1",
    "sql.js": "^1.14.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantinn/backendguard.git"
  },
  "bugs": {
    "url": "https://github.com/vantinn/backendguard/issues"
  },
  "homepage": "https://github.com/vantinn/backendguard#readme",
  "publishConfig": {
    "access": "public"
  }
}
